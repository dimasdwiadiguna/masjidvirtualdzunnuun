# Alamat publik app, dipakai untuk gambar pratinjau tautan dan metadata.
# Boleh dikosongkan di Vercel: alamat produksi dari Vercel yang akan dipakai.
# Isi manual kalau app sudah punya domain sendiri.
NEXT_PUBLIC_SITE_URL=https://dzunnuun.vercel.app

# Password pengurus inti (superadmin). Bisa mengurus semuanya. Wajib diisi.
ADMIN_PASSWORD=ganti-dengan-password-panjang
# Password panitia acara. Boleh 8 karakter. Hanya bisa mengurus acara,
# pendaftar, check-in, laporan, pengumuman, dan foto hero. Kalau dikosongkan,
# app berjalan dengan satu password saja seperti sebelumnya.
ADMIN_PASSWORD_PANITIA=

# Kunci penanda tangan cookie sesi admin. Kalau kosong, ADMIN_PASSWORD yang dipakai.
# Isi dengan teks acak panjang supaya sesi tidak ikut berubah saat password diganti.
ADMIN_SESSION_SECRET=

# Supabase. URL boleh publik, service role key TIDAK BOLEH bocor ke klien.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
